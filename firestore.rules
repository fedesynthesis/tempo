rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Task: ognuno legge/scrive SOLO i propri (campo uid = proprio account).
    match /tempo_tasks/{id} {
      allow read:   if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if false;   // non si cancella mai davvero: si usano i "tombstone" (deleted:true)
    }

    // Categorie per-utente (id del documento = uid).
    match /tempo_cats/{userId} {
      allow read, write: if request.auth != null && userId == request.auth.uid;
    }

    // Token notifiche push: l'utente loggato può registrare/aggiornare il proprio token.
    match /tempo_tokens/{token} {
      allow read:  if false;                      // solo lo scheduler (admin) legge
      allow write: if request.auth != null;
    }

    // Meta (guardia del digest): la tocca solo lo scheduler con privilegi admin (bypassa le regole).
    match /tempo_meta/{doc} {
      allow read, write: if false;
    }

    // Tutto il resto: vietato.
    match /{document=**} { allow read, write: if false; }
  }
}
